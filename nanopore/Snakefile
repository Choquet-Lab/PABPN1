    output :
        bam1 = "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_1.bam",
        bam2= "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_2.bam",
        bam3= "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_3.bam",
        bam4= "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_4.bam"
    log:
        error='logs_error/split_multiplexed_bam.e'
    params :
        directory = "results"
    shell :
        """
        module load cuda
        module load apptainer
        apptainer run --nv --no-home \
            --bind {params.directory}:/data:rw \
            /home/sbache/projects/def-kchoquet/sbache/scripts/seqtagger.sif bam_split_by_barcode.py \
            -i /data/demux/p2_rep4/pod5.demux.tsv.gz \
            -f /data/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bam \
            -o /data/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort
        """

rule rename_bam_from_multiplex :
    threads : 1
    input :
        bam1 = "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_1.bam",
        bam2 = "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_2.bam",
        bam3 = "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_3.bam",
        bam4 = "results/alignment_bam/p2_rep4/p2_rep4_minimap2_uniq_sort.bc_4.bam"
    output :
        shCTL_cyto_rep4_bam = "results/alignment_bam/shCTL_cyto_rep4/shCTL_cyto_rep4_minimap2_uniq_sort.bam",
        shPABPN1_cyto_rep4_bam = "results/alignment_bam/shPABPN1_cyto_rep4/shPABPN1_cyto_rep4_minimap2_uniq_sort.bam",
        shCTL_noyau_rep4_bam = "results/alignment_bam/shCTL_noyau_rep4/shCTL_noyau_rep4_minimap2_uniq_sort.bam",
        shPABPN1_noyau_rep4_bam = "results/alignment_bam/shPABPN1_noyau_rep4/shPABPN1_noyau_rep4_minimap2_uniq_sort.bam"
    log:
        error='logs_error/rename_bam_from_multiplex.e'
    shell :
        """
        module load samtools
        cp {input.bam1} {output.shCTL_cyto_rep4_bam}
        cp {input.bam2} {output.shPABPN1_cyto_rep4_bam}
        cp {input.bam3} {output.shCTL_noyau_rep4_bam}
        cp {input.bam4} {output.shPABPN1_noyau_rep4_bam}
        samtools index {output.shCTL_cyto_rep4_bam}
        samtools index {output.shPABPN1_cyto_rep4_bam}
        samtools index {output.shCTL_noyau_rep4_bam}
        samtools index {output.shPABPN1_noyau_rep4_bam}
        """

rule bed_from_bam_rep4 :
    threads : 1
    wildcard_constraints:
        rep4_sample="|".join(rep4_samples)
    input :
        "results/alignment_bam/{rep4_sample}/{rep4_sample}_minimap2_uniq_sort.bam"
    output :
        "results/alignment_bam/{rep4_sample}/{rep4_sample}_minimap2_uniq_sort.bed"
    params:
        direct="results/alignment_bam/{rep4_sample}/"
    log:
        error_bamtobed='logs_error/bed_from_bam_{rep4_sample}.e',
        error_polya='logs_error/polya_tmp_{rep4_sample}.e'
    shell :
        """
        module load StdEnv/2020
        module load samtools/1.17
        module load bedtools/2.30.0
        bedtools bamtobed -cigar -tag NM -i {input} > {params.direct}uniq_sort_tmp.bed 2>{log.error_bamtobed}
        samtools view {input} | awk '{{
            pt = "NA";
            for (i=12; i<=NF; i++) {{
                if ($i ~ /^pt:i:/) pt = substr($i,6)
            }}
            print pt
        }}' > {params.direct}polya.txt 2>{log.error_polya}
        paste {params.direct}uniq_sort_tmp.bed {params.direct}polya.txt > {output}
        """

