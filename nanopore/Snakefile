rule modkit :
    threads : 4
    wildcard_constraints:
        m6A_sample="|".join(m6A_samples)
    input :
        "results/alignment_bam/{m6A_sample}/{m6A_sample}_minimap2_uniq_sort.bam"
    output :
        bed = "results/modkit/{m6A_sample}_m6A.bed",
        bed_compressed = "results/modkit/{m6A_sample}_m6A.bed.gz"
    log:
        error='logs_error/modkit_{m6A_sample}.e'
    conda:
        "envs/modkit.yaml"
    shell :
        """
        module load tabix/0.2.6
        modkit pileup -t {threads} {input} {output.bed} --filter-threshold A:0.90
        bgzip -c {output.bed} > {output.bed_compressed}
        tabix -p bed {output.bed_compressed}
        """

