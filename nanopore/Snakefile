        index="results/alignment_bam/{sample}/{sample}_minimap2_sort.bam.bai"
    log:
        error='logs_error/samtools_sort_index_{sample}.e'
    shell :
        """
        module load StdEnv/2020
        module load samtools/1.17
        samtools sort {input} -o {output.bam} 2>{log.error}
        samtools index {output.bam}
        """

rule extract_unique_reads :
    threads : 4
    wildcard_constraints:
        sample="|".join(all_samples)
    input :
        sort_bam="results/alignment_bam/{sample}/{sample}_minimap2_sort.bam",
        sam="results/alignment_bam/{sample}/{sample}_minimap2.sam"
    output :
        bam="results/alignment_bam/{sample}/{sample}_minimap2_uniq_sort.bam",
        index="results/alignment_bam/{sample}/{sample}_minimap2_uniq_sort.bam.bai"
    params:
        direct="results/alignment_bam/{sample}/",
        reference="/home/sbache/projects/def-kchoquet/reference_libraries/hg38/Homo_sapiens.GRCh38.dna.primary_assembly.and.sacCer3_ENO2.fa"
    log :
        error = 'logs_error/extract_unique_reads_{sample}.e'
    shell :
        """
        module load StdEnv/2020
        module load samtools/1.17
        grep ^@ {input.sam} > {params.direct}headers.sam
        grep -v ^@  {input.sam} | sort > {params.direct}alignment.sam
        awk '$3!="*" {{print}}' {params.direct}alignment.sam | cut -f 1 | sort | uniq -c | awk '$1==1 {{print $2}}' > {params.direct}uniq_names.txt
        grep -F -f {params.direct}uniq_names.txt {params.direct}alignment.sam > {params.direct}uniq_alignment.sam
        cat {params.direct}headers.sam {params.direct}uniq_alignment.sam > {params.direct}headers_uniq_temp.sam
        samtools view -bT {params.reference} {params.direct}headers_uniq_temp.sam > {params.direct}headers_uniq_temp.bam
        samtools sort {params.direct}headers_uniq_temp.bam -o {output.bam} 2>{log.error}
        samtools index {output.bam}
        rm {params.direct}headers.sam
        rm {params.direct}alignment.sam
        rm {params.direct}uniq_names.txt
        rm {params.direct}uniq_alignment.sam
        rm {params.direct}headers_uniq_temp.sam
        rm {params.direct}headers_uniq_temp.bam
        """

rule bed_from_bam :
    threads : 1
    wildcard_constraints:
        minion_p2_run1_sample="|".join(minion_p2_run1_samples)
    input :
        "results/alignment_bam/{minion_p2_run1_sample}/{minion_p2_run1_sample}_minimap2_uniq_sort.bam"
    output :
        "results/alignment_bam/{minion_p2_run1_sample}/{minion_p2_run1_sample}_minimap2_uniq_sort.bed"
    params:
        direct="results/alignment_bam/{minion_p2_run1_sample}/"
    log:
        error_bamtobed='logs_error/bed_from_bam_{minion_p2_run1_sample}.e',
        error_polya='logs_error/polya_tmp_{minion_p2_run1_sample}.e'
    shell :
        """
        module load StdEnv/2020
        module load samtools/1.17
        module load bedtools/2.30.0
        bedtools bamtobed -cigar -tag NM -i {input} > {params.direct}uniq_sort_tmp.bed 2>{log.error_bamtobed}
        samtools view {input} | awk '{{
            pt = "NA";
            for (i=12; i<=NF; i++) {{
                if ($i ~ /^pt:i:/) pt = substr($i,6)
            }}
            print pt
        }}' > {params.direct}polya.txt 2>{log.error_polya}
        paste {params.direct}uniq_sort_tmp.bed {params.direct}polya.txt > {output}
        """

